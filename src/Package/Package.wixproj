<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>git</OutputName>
    <Platform>x64</Platform>
    <BindInputPaths>..\..\lib\</BindInputPaths>
    <SuppressICEs>ICE60;ICE80</SuppressICEs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.NetFx.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Dependency.wixext" Version="6.0.2" />
    <PackageReference Include="FireGiant.HeatWave.BuildTools.wixext" Version="6.0.0" />
  </ItemGroup>
</Project>
