<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
<Bundle Name="!(bind.packageName.git.msi)" Manufacturer="!(bind.packageManufacturer.git.msi)" Version="!(bind.packageVersion.git.msi)" UpgradeCode="4adb169f-377b-4a52-b817-4ecee51fe64d" IconSourceFile="git.ico" ProviderKey="GitSetupBundle">

  <BootstrapperApplication>
    <bal:WixStandardBootstrapperApplication LicenseUrl="http://www.opensource.org/licenses/gpl-2.0" LogoFile="git.png" Theme="hyperlinkLicense" />
  </BootstrapperApplication>

  <Variable Name="InstallFolder" Value="[ProgramFilesFolder]Git" Type="formatted" />

  <Chain>
    <MsiPackage Id="git.msi" SourceFile="$(var.Package.TargetPath)">
      <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
    </MsiPackage>
  </Chain>
</Bundle>
</Wix>
